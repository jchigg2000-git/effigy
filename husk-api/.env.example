# Per-solution environment variables. See docs/handoffs for each solution's required vars.

# === Solution: llm-translation ===
# Base URL of an OpenAI-compatible chat completions endpoint.
# Default targets a local Ollama instance.
LLM_BASE_URL=http://localhost:11434/v1

# Model name as the backend understands it.
LLM_MODEL=qwen2.5-coder:14b

# API key. Ollama ignores it; HF Inference / OpenAI / vLLM may require it.
LLM_API_KEY=ollama

# Request timeout in seconds. Translation of large modules can take a while.
LLM_TIMEOUT_SECONDS=180

# Optional: temperature. Lower = more deterministic translations.
LLM_TEMPERATURE=0.2

# Optional: max output tokens.
LLM_MAX_TOKENS=4096

# === Solution: fpe ===
# Hex-encoded key (32 hex chars = 16 bytes). SET THIS FOR ANY REAL USE.
# Without it a random key is generated per process: husks are valid within one
# run, but pseudonyms change on restart and an older re-identification map will
# no longer dehusk. A malformed value raises rather than falling back.
#
# Generate one with:
#   python3 -c 'import secrets; print(secrets.token_hex(16))'
#
# Never commit a real key. This file ships with the placeholder commented out
# deliberately -- a literal example key here would just recreate the problem
# that FPE_DEMO_KEY documents.
# FPE_KEY=

# Set to encipher under the PUBLIC source-baked demo key. Trivially reversible
# by anyone holding this repo. Only for reproducing recorded eval outputs.
# FPE_DEMO_KEY=1

# Set to "production" to make fpe refuse to start without FPE_KEY.
# EFFIGY_ENV=production

# Note: crumb_level is accepted on the wire for contract uniformity but is
# IGNORED by this solution. Target selection uses options.target_id (catalog)
# or options.target_domain (free-text override). See handoff 06.

# === Post-condition gate (all three solutions) ===
# The shipped fail-closed check that refuses to return a husk which is
# substantially its own input. This is the ONLY mechanical enforcement in the
# service -- there is no verifier (LIMITATIONS.md section 5). Loosening any of
# these disables it. Defaults shown.
#
# HUSK_CHECK_RUN_LINES=20       # a verbatim run this long counts as copied
# HUSK_CHECK_RUN_SHARE=0.15     # ...or this share of code lines
# HUSK_CHECK_COPIED_SHARE=0.35  # total copied-span share that fails the husk
# HUSK_CHECK_RETENTION=0.92     # identifier retention that fails the husk
# HUSK_CHECK_RATIO=0.95         # whole-file similarity that fails the husk
# HUSK_CHECK_MIN_LINES=12       # inputs shorter than this skip the gate
# HUSK_CHECK_MODULE_NAMES=1     # 0 disables the input-module-name check
#
# llm-translation only:
# HUSK_CHECK_RETRIES=1          # retries before the gate raises
